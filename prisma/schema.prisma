generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model mytable {
  id       String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name     String
  phone    String    @unique
  email    String    @unique
  projects project[]
}

model client {
  id          Int       @id @default(autoincrement())
  name        String
  companyname String
  email       String    @unique
  phone       String    @unique
  projects    project[]
}

model project {
  projectid   Int     @id @default(autoincrement())
  projectname String
  description String?
  status      String  @default("Pending")

  userId   String @db.Uuid
  clientId Int

  employee mytable @relation(fields: [userId], references: [id], onDelete: Restrict)
  client   client  @relation(fields: [clientId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
